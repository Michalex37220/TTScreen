# À copier vers /etc/ttscreen/ttscreen.env puis :  sudo chown root:ttscreen /etc/ttscreen/ttscreen.env && sudo chmod 640 /etc/ttscreen/ttscreen.env
# (format systemd : une ligne CLÉ=valeur, sans guillemets ni « export »)
TTSCREEN_ENV=production
TTSCREEN_HOST=127.0.0.1
TTSCREEN_PORT=8000

# SQLite suffit pour quelques dizaines d'écrans (sauvegarde : voir docs/DEPLOIEMENT.md). Pour PostgreSQL :
#   TTSCREEN_DATABASE_URL=postgresql://ttscreen:MOT_DE_PASSE_SANS_CARACTERES_SPECIAUX@127.0.0.1:5432/ttscreen
TTSCREEN_DATABASE_URL=sqlite:////var/lib/ttscreen/ttscreen.db
TTSCREEN_MEDIA_DIR=/var/lib/ttscreen/media
TTSCREEN_FRONTEND_DIR=/opt/ttscreen/frontend
TTSCREEN_PLAYER_DIR=/opt/ttscreen/player

# Caddy tourne sur la même machine et transmet l'IP réelle : on ne fait confiance qu'à lui (loopback)
FORWARDED_ALLOW_IPS=127.0.0.1

# Compte admin d'amorçage (retirer le mot de passe de ce fichier une fois le compte créé)
TTSCREEN_BOOTSTRAP_ADMIN_USER=admin
TTSCREEN_BOOTSTRAP_ADMIN_PASSWORD=
# Jeton admin historique (facultatif, 24 caractères minimum et variés)
TTSCREEN_ADMIN_TOKEN=
# Fuseau horaire des plannings d'écrans (nom IANA)
TTSCREEN_TIMEZONE=Europe/Paris
RUST_LOG=info
