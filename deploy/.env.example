# Copier vers deploy/.env sur le serveur (jamais commité).
DOMAIN=ttscreen.exemple.fr
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TTSCREEN_ADMIN_TOKEN=
POSTGRES_PASSWORD=
# Compte admin nommé créé au démarrage (facultatif, recommandé en production) :
# TTSCREEN_BOOTSTRAP_ADMIN_USER=admin
# TTSCREEN_BOOTSTRAP_ADMIN_PASSWORD=
# Limitation de débit (fenêtre de 60 s par défaut) et durée des sessions (heures) :
# TTSCREEN_RATE_WINDOW_S=60
# TTSCREEN_RATE_LIMIT_API=600
# TTSCREEN_RATE_LIMIT_PLAYER=120
# TTSCREEN_RATE_LIMIT_LOGIN=20
# TTSCREEN_SESSION_TTL_H=12
