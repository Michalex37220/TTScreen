# Copier vers deploy/.env sur le serveur, puis : chmod 600 deploy/.env   (ne jamais le commiter).
# ./scripts/deploy.sh vérifie ces valeurs avant de démarrer quoi que ce soit.

# Nom de domaine pointant (enregistrement A/AAAA) vers ce serveur : Caddy y obtient le certificat HTTPS.
DOMAIN=ttscreen.exemple.fr

# Mot de passe PostgreSQL. Il est inséré dans une URL : uniquement des lettres, chiffres, "_", "." , "-" ou "~"
# (pas de + / = @ : ils casseraient l'URL). 20 caractères minimum. Générer avec :
#   openssl rand -base64 32 | tr "+/" "-_" | tr -d "="
POSTGRES_PASSWORD=

# --- Connexion à l'administration : au moins UNE des deux options (recommandé : le compte d'amorçage) ---
# Compte admin nommé créé au démarrage (8 caractères minimum pour le mot de passe) :
# TTSCREEN_BOOTSTRAP_ADMIN_USER=admin
# TTSCREEN_BOOTSTRAP_ADMIN_PASSWORD=
# Créé seulement s'il n'existe aucun admin ; un compte existant n'est plus jamais modifié au redémarrage.
# Retirez TTSCREEN_BOOTSTRAP_ADMIN_PASSWORD de ce fichier une fois le compte créé et le mot de passe changé.
# Récupération d'accès (réinitialise ce compte ; à retirer ensuite) : TTSCREEN_BOOTSTRAP_ADMIN_RESET=true
#
# Jeton admin historique (facultatif) : 24 caractères minimum et variés, sinon l'API refuse de démarrer.
# Il est refusé dès qu'un compte admin nommé actif existe (sauf TTSCREEN_LEGACY_TOKEN_ALWAYS=true).
TTSCREEN_ADMIN_TOKEN=

# --- Réglages facultatifs (valeurs par défaut indiquées) ---
# Taille maximale d'un média en Mo. Si vous la changez, adaptez UPLOAD_MAX_BODY (≈ +5 %, en MB).
# TTSCREEN_MAX_UPLOAD_MB=200
# UPLOAD_MAX_BODY=210MB
# Limitation de débit (fenêtre de 60 s) et durée des sessions (heures) :
# TTSCREEN_RATE_LIMIT_API=600
# TTSCREEN_RATE_LIMIT_PLAYER=120
# TTSCREEN_RATE_LIMIT_LOGIN=20
# TTSCREEN_SESSION_TTL_H=12
# Fuseau horaire des plannings d'écrans (nom IANA, ex. Europe/Paris, America/Montreal) :
# TTSCREEN_TIMEZONE=Europe/Paris
# Niveau de journalisation de l'API : error, warn, info, debug
# RUST_LOG=info
