# Copier vers deploy/.env sur le serveur (jamais commité).
DOMAIN=ttscreen.exemple.fr
# Jeton admin historique (facultatif si un compte d'amorçage est défini ci-dessous) : 24 caractères
# minimum et variés, sinon l'API refuse de démarrer. Il est refusé dès qu'un compte admin nommé actif
# existe (sauf TTSCREEN_LEGACY_TOKEN_ALWAYS=true). Générer avec :
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TTSCREEN_ADMIN_TOKEN=
POSTGRES_PASSWORD=
# Compte admin nommé créé au démarrage (facultatif, recommandé en production) :
# TTSCREEN_BOOTSTRAP_ADMIN_USER=admin
# TTSCREEN_BOOTSTRAP_ADMIN_PASSWORD=
# Créé seulement s'il n'existe aucun admin ; un compte existant n'est plus jamais modifié au redémarrage.
# Récupération d'accès (réinitialise ce compte, à retirer ensuite) : TTSCREEN_BOOTSTRAP_ADMIN_RESET=true
# Retirer TTSCREEN_BOOTSTRAP_ADMIN_PASSWORD de ce fichier une fois le compte créé.
# Limitation de débit (fenêtre de 60 s par défaut) et durée des sessions (heures) :
# TTSCREEN_RATE_WINDOW_S=60
# TTSCREEN_RATE_LIMIT_API=600
# TTSCREEN_RATE_LIMIT_PLAYER=120
# TTSCREEN_RATE_LIMIT_LOGIN=20
# TTSCREEN_SESSION_TTL_H=12
